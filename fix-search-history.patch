+// ---------------------------------------------------------------
+// ประวัติการค้นหา (ตาราง search_history: search_id, user_id, keyword, created_at)
+// ---------------------------------------------------------------
+export async function fetchSearchHistory(userId) {
+  const { data, error } = await supabase
+    .from("search_history")
+    .select("search_id, keyword, created_at")
+    .eq("user_id", userId)
+    .order("created_at", { ascending: false })
+    .limit(30);
+  if (error) throw error;
+  // คำเดียวกันที่ค้นซ้ำ เก็บเฉพาะอันล่าสุด
+  const seen = new Set();
+  return (data || [])
+    .filter((r) => {
+      const k = String(r.keyword).toLowerCase();
+      if (seen.has(k)) return false;
+      seen.add(k);
+      return true;
+    })
+    .slice(0, 10)
+    .map((r) => ({ id: r.search_id, keyword: r.keyword }));
+}
+
+export async function saveSearchKeyword(userId, keyword) {
+  const kw = String(keyword || "").trim();
+  if (!kw) return null;
+  // ลบคำเดิมที่ซ้ำก่อน แล้วเพิ่มใหม่ให้ขึ้นเป็นล่าสุด
+  await supabase
+    .from("search_history")
+    .delete()
+    .eq("user_id", userId)
+    .ilike("keyword", kw.replace(/[%_]/g, (c) => "\\" + c));
+  const { data, error } = await supabase
+    .from("search_history")
+    .insert({ user_id: userId, keyword: kw })
+    .select("search_id, keyword")
+    .single();
+  if (error) throw error;
+  return { id: data.search_id, keyword: data.keyword };
+}
+
+export async function deleteSearchKeyword(searchId, userId) {
+  const { error } = await supabase
+    .from("search_history")
+    .delete()
+    .eq("search_id", searchId)
+    .eq("user_id", userId);
+  if (error) throw error;
+}
+
+export async function clearSearchHistory(userId) {
+  const { error } = await supabase
+    .from("search_history")
+    .delete()
+    .eq("user_id", userId);
+  if (error) throw error;
+}
