+// ---------------------------------------------------------------
+// ประวัติการสแกน (ตาราง scan_history)
+// ---------------------------------------------------------------
+function mapScanRow(r) {
+  return {
+    id: r.id,
+    at: new Date(r.created_at).getTime(),
+    prompt: r.prompt || "",
+    ingredients: Array.isArray(r.ingredients) ? r.ingredients : [],
+    menus: Array.isArray(r.menus) ? r.menus : [],
+    saved: true,
+  };
+}
+
+export async function fetchScanHistory(userId) {
+  const { data, error } = await supabase
+    .from("scan_history")
+    .select("id, prompt, ingredients, menus, created_at")
+    .eq("user_id", userId)
+    .order("created_at", { ascending: false })
+    .limit(50);
+  if (error) throw error;
+  return (data || []).map(mapScanRow);
+}
+
+export async function saveScanInDB(userId, scan) {
+  const { data, error } = await supabase
+    .from("scan_history")
+    .insert({
+      user_id: userId,
+      prompt: scan.prompt || "",
+      ingredients: scan.ingredients || [],
+      menus: scan.menus || [],
+    })
+    .select("id, prompt, ingredients, menus, created_at")
+    .single();
+  if (error) throw error;
+  return mapScanRow(data);
+}
+
+export async function deleteScanInDB(id, userId) {
+  const { error } = await supabase
+    .from("scan_history")
+    .delete()
+    .eq("id", id)
+    .eq("user_id", userId);
+  if (error) throw error;
+}
+
+// ---------------------------------------------------------------
+// บันทึกมื้ออาหาร / แคลอรี่ที่กินวันนี้ (ตาราง meal_logs)
+// ---------------------------------------------------------------
+function mapMealRow(r) {
+  return {
+    id: r.id,
+    postId: r.post_id,
+    title: r.title || "มื้ออาหาร",
+    kcal: Number(r.kcal) || 0,
+    at: new Date(r.eaten_at).getTime(),
+  };
+}
+
+// ดึงมื้อที่กินตั้งแต่เที่ยงคืนของวันนี้ (เวลาในเครื่องผู้ใช้)
+export async function fetchMealsToday(userId) {
+  const start = new Date();
+  start.setHours(0, 0, 0, 0);
+  const { data, error } = await supabase
+    .from("meal_logs")
+    .select("id, post_id, title, kcal, eaten_at")
+    .eq("user_id", userId)
+    .gte("eaten_at", start.toISOString())
+    .order("eaten_at", { ascending: false });
+  if (error) throw error;
+  return (data || []).map(mapMealRow);
+}
+
+export async function addMealInDB(userId, meal) {
+  const { data, error } = await supabase
+    .from("meal_logs")
+    .insert({
+      user_id: userId,
+      post_id: meal.postId != null ? String(meal.postId) : null,
+      title: meal.title || "มื้ออาหาร",
+      kcal: Math.round(Number(meal.kcal) || 0),
+    })
+    .select("id, post_id, title, kcal, eaten_at")
+    .single();
+  if (error) throw error;
+  return mapMealRow(data);
+}
+
+export async function deleteMealInDB(id, userId) {
+  const { error } = await supabase
+    .from("meal_logs")
+    .delete()
+    .eq("id", id)
+    .eq("user_id", userId);
+  if (error) throw error;
+}
